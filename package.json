{
  "name": "mongorm",
  "version": "0.1.0",
  "description": "A TypeScript-first MongoDB ORM monorepo",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present --parallel run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --recursive --parallel --filter './apps/*' run dev",
    "docs:build": "pnpm --filter @mongorm/docs run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint packages apps",
    "lint:fix": "oxlint --fix packages apps",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm build && pnpm --recursive --if-present run typecheck",
    "version:bump": "bumpp --recursive"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "bumpp": "^12.3.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.27.1"
}
