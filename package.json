  "description": "A TypeScript-first MongoDB ORM for applications that want strong types without hiding MongoDB",
  "keywords": [
    "mongodb",
    "orm",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/hdytrfli/orm#readme",
